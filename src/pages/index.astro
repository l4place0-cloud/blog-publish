---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpaceItem from '../components/SpaceItem.astro';
import { site, socialLinks } from '../config/site';
import { formatDate, getArticles, getProjects, getSpace } from '../lib/content';
import { withBase } from '../lib/paths';

const [articles, projects, space] = await Promise.all([getArticles(), getProjects(), getSpace()]);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const recentArticles = articles.slice(0, 4);
const recentSpace = space.slice(0, 4);
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">{site.heroKicker} · {site.location}</p>
        <h1 class="hero-name">{site.name}</h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-copy">{site.intro}</p>
      </div>
      <div class="hero-side">
        <div class="hero-index"><span>{site.systemLabel}</span><span>001</span></div>
        <div class="hero-actions">
          <a class="button primary" href={withBase('/projects')}>查看项目</a>
          <a class="button secondary" href={withBase('/articles')}>阅读文章</a>
        </div>
        <div class="social-row">
          {socialLinks.map((link) => <a href={link.href}>{link.label} ↗</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="now-panel" aria-labelledby="now-title">
    <div class="shell now-grid">
      <div><p class="eyebrow">Now</p><h2 id="now-title">此刻正在发生</h2><small class="now-updated">更新于 {formatDate(site.now.updatedAt)}</small></div>
      <div class="now-item"><span>正在做</span><p>{site.now.doing}</p></div>
      <div class="now-item"><span>正在关注</span><p>{site.now.learning}</p></div>
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="featured-projects">
    <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2 id="featured-projects">精选项目</h2></div><a class="text-link" href={withBase('/projects')}>查看全部项目 <span>→</span></a></div>
    <div class="project-grid">{featuredProjects.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="recent-articles">
    <div class="section-heading"><div><p class="eyebrow">Long-form</p><h2 id="recent-articles">最近文章</h2></div><a class="text-link" href={withBase('/articles')}>查看全部文章 <span>→</span></a></div>
    <div class="article-list">{recentArticles.map((article, index) => <ArticleCard article={article} featured={index === 0 && article.data.featured} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="latest-space">
    <div class="section-heading"><div><p class="eyebrow">In the moment</p><h2 id="latest-space">最新空间</h2></div><a class="text-link" href={withBase('/space')}>进入空间 <span>→</span></a></div>
    <div class="space-list">{recentSpace.map((item) => <SpaceItem item={item} />)}</div>
  </section>

  <section class="home-section shell about-intro">
    <div class="portrait-mark" aria-hidden="true">{site.monogram}</div>
    <div>
      <p class="eyebrow">About & contact</p>
      <div class="about-copy"><p>{site.bio}</p></div>
      <a class="text-link" href={withBase('/about')}>更多关于我 <span>→</span></a>
      <div class="social-row" style="margin-top: 24px">{socialLinks.map((link) => <a href={link.href}>{link.label} ↗</a>)}</div>
    </div>
  </section>
</BaseLayout>
