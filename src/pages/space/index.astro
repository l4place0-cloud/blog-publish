---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpaceItem from '../../components/SpaceItem.astro';
import { site } from '../../config/site';
import { formatMonth, getSpace } from '../../lib/content';
const space = await getSpace();
const page = site.pages.space;
const groups = Map.groupBy(space, (item) => formatMonth(item.data.publishedAt));
---
<BaseLayout title={page.title} description={page.seoDescription}>
  <header class="page-header"><div class="shell page-header-grid"><div><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1></div><p>{page.description}</p></div></header>
  <div class="shell page-content space-list">
    {[...groups.entries()].map(([month, items]) => <section aria-labelledby={`month-${month}`}><h2 class="month-heading" id={`month-${month}`}>{month}</h2>{items.map((item) => <SpaceItem item={item} />)}</section>)}
  </div>
</BaseLayout>
